# URL base de la API de Laravel (sin barra final).
# Debe apuntar al prefijo versionado, p. ej. http://localhost:8000/api/v1
VITE_API_URL=http://localhost:8000/api/v1

# IMPORTANTE: nunca pongas credenciales, secretos ni claves privadas en
# variables VITE_*. Todo lo que empiece por VITE_ se expone en el navegador.
