# =========================================================
# Monorepo: backend (Laravel) + frontend (Vite/React)
# Arquitectura desacoplada
# =========================================================

# ---- Variables de entorno y secretos ----
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
*.key
*.pem
*.p12
*.pfx
backend/auth.json
backend/.phpactor.json
Homestead.json
Homestead.yaml

# ---- Dependencias (nunca versionar) ----
node_modules/
**/node_modules/
vendor/
**/vendor/

# ---- Artefactos de build / caché ----
frontend/dist/
frontend/dist-ssr/
frontend/*.local
frontend/*.tsbuildinfo
**/*.tsbuildinfo
backend/public/build/
backend/public/hot
backend/public/storage
backend/bootstrap/cache/*.php
backend/storage/pail/
backend/.phpunit.cache/
backend/.phpunit.result.cache

# ---- Almacenamiento y logs de Laravel ----
backend/storage/*.key
backend/storage/oauth-*.key
backend/storage/logs/*.log
backend/storage/framework/cache/data/*
backend/storage/framework/sessions/*
backend/storage/framework/views/*
backend/storage/framework/testing/*
backend/storage/app/private/*
backend/storage/app/public/*

# ---- Bases de datos locales / respaldos ----
backend/database/*.sqlite
backend/database/*.sqlite-journal
backend/database/*.sqlite-wal
backend/database/*.sqlite-shm
*.sql
*.sql.gz
*.dump

# ---- Logs ----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---- Editor / Sistema operativo ----
.vscode/*
!.vscode/extensions.json
.idea/
.fleet/
.nova/
.zed/
.DS_Store
Thumbs.db
*.swp
*.swo
*~
